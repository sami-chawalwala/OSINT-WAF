    def detect_waf(self):
        print(f"\n[+] 🛡️  WAF Detection activated for: {self.url}...")
        self.sources_used.add('WAF Detection')
        
        try:
            result = subprocess.run(
                ['wafw00f', '-a', '-v', self.url],
                capture_output=True,
                text=True,
                timeout=30
            )
            
            if result.returncode == 0:
                output = result.stdout
                stderr = result.stderr
                
                clean_details = []
                for line in output.strip().split('\n'):
                    if not any(x in line for x in ['?', '_', '`', '(', ')', '/', '\\', '|', '.', ',', "'", '"']):
                        if line.strip() and not line.startswith(' ' * 10):
                            clean_details.append(line.strip())
                self.waf_details = clean_details
                
                self.waf_confidence = "HIGH"
                conf_match = re.search(r'confidence:?\s*(\w+)', output, re.IGNORECASE)
                if conf_match:
                    self.waf_confidence = conf_match.group(1).upper()
                
                waf_patterns = [
                    r'is behind (.+?)\s*WAF',
                    r'is behind (.+?)\s*\(',
                    r'is behind (.+?)(?:\s+\(|$)',
                    r'behind (.+?)\s*WAF',
                    r'\[+\] The site .+? is behind (.+?)(?:\s+\(|$)',
                    r'WAF:\s*(.+?)(?:\s+\(|$)',
                    r'Detected WAF:\s*(.+?)(?:\s+\(|$)',
                    r'waf:\s*(.+?)(?:\s+\(|$)',
                    r'Firewall:\s*(.+?)(?:\s+\(|$)',
                ]
                
                waf_detected = None
                for pattern in waf_patterns:
                    match = re.search(pattern, output, re.IGNORECASE)
                    if match:
                        waf_detected = match.group(1).strip()
                        break
                
                generic_match = re.search(r'Generic Detection results?:\s*(.+)', output, re.IGNORECASE)
                self.generic_detection = generic_match.group(1).strip() if generic_match else "N/A"
                
                req_match = re.search(r'Number of requests?:\s*(\d+)', output, re.IGNORECASE)
                self.request_count = req_match.group(1) if req_match else "N/A"
                
                self.notes = []
                if "timeout" in stderr.lower() or "timeout" in output.lower():
                    timeout_match = re.search(r'(\d+)s?\s*timeout', stderr.lower() + output.lower(), re.IGNORECASE)
                    if timeout_match:
                        self.notes.append(f"WAFW00F generic detection encountered a {timeout_match.group(1)}s HTTPS timeout")
                self.notes.append("Detection indicates a security layer; exact configuration is not inferred")
                
                if 'No WAF detected' in output or 'No WAF' in output:
                    self.waf_detected = "No WAF Detected"
                    self.waf_confidence = "N/A"
                elif waf_detected:
                    self.waf_detected = waf_detected
                    self.waf_details.insert(0, f"Fingerprint match: {waf_detected}")
                else:
                    lines = output.split('\n')
                    for line in lines:
                        if 'behind' in line.lower() or 'waf' in line.lower():
                            parts = line.split()
                            for part in parts:
                                if part and part[0].isupper() and len(part) > 3:
                                    if any(x in part.lower() for x in ['cloudflare', 'aws', 'akamai', 'kona', 'incapsula', 'sucuri']):
                                        self.waf_detected = part
                                        break
                            if self.waf_detected:
                                break
                    
                    if not self.waf_detected:
                        self.waf_detected = "Unknown (check details below)"
                    else:
                        self.waf_details.insert(0, f"Fingerprint match: {self.waf_detected}")
                
                print(f"[+]  WAF Detection complete")
                return
                
        except FileNotFoundError:
            print("[+]   wafw00f not installed - using fallback detection")
            self.failed_sources.add('wafw00f (not installed)')
            self.notes = ["wafw00f not installed - using basic detection", "Detection indicates a security layer; exact configuration is not inferred"]
        except subprocess.TimeoutExpired:
            print("[+]   wafw00f timed out - using fallback detection")
            self.failed_sources.add('wafw00f (timeout)')
            self.notes = ["WAFW00F generic detection encountered a timeout", "Detection indicates a security layer; exact configuration is not inferred"]
        except Exception as e:
            print(f"[+]   wafw00f error: {e} - using fallback detection")
            self.failed_sources.add(f'wafw00f ({str(e)})')
            self.notes = [f"wafw00f error: {str(e)}", "Detection indicates a security layer; exact configuration is not inferred"]
        
        self._basic_waf_detection()
    
    def _basic_waf_detection(self):
        print("[+]  Running basic WAF detection...")
        
        try:
            response = requests.get(self.url, headers=self.headers, timeout=10)
            normal_status = response.status_code
            headers = response.headers
            
            test_url = self.url + "' OR '1'='1"
            test_response = requests.get(test_url, headers=self.headers, timeout=10, allow_redirects=False)
            security_status = test_response.status_code
            
            server_header = headers.get('Server', '').lower()
            set_cookie = headers.get('Set-Cookie', '').lower()
            
            waf_signatures = {
                'Cloudflare': ['cloudflare', 'cf-ray', '__cfduid', 'cf-cache-status'],
                'Kona SiteDefender': ['kona', 'akamai', 'x-akamai', 'x-akamai-transformed'],
                'AWS WAF': ['x-amzn-requestid', 'aws', 'x-amzn-request-id'],
                'Akamai': ['akamaitech', 'akamaitechnologies', 'x-akamai'],
                'Fastly': ['fastly', 'x-fastly', 'x-served-by'],
                'Incapsula': ['incapsula', 'x-cdn', 'x-iinfo'],
                'Sucuri': ['sucuri', 'x-sucuri', 'x-sucuri-id'],
                'ModSecurity': ['mod_security', 'modsecurity', 'x-modsecurity'],
                'F5 BIG-IP': ['f5', 'big-ip', 'x-wa-info', 'bigip'],
                'Barracuda': ['barracuda', 'cuda'],
                'CloudFront': ['cloudfront', 'x-amz-cf-id'],
                'Azure WAF': ['azure', 'x-azure'],
                'Wordfence': ['wordfence', 'wf_'],
                'Imperva': ['imperva', 'x-iinfo', 'incapsula'],
                'SiteGround': ['siteground', 'sg-'],
            }
            
            detected = []
            header_str = str(headers).lower()
            
            for waf_name, signatures in waf_signatures.items():
                for sig in signatures:
                    if sig in server_header or sig in set_cookie or sig in header_str:
                        detected.append(waf_name)
                        break
            
            if response.status_code in [403, 406, 503] or test_response.status_code in [403, 406, 503]:
                if 'cloudflare' in str(response.content).lower():
                    detected.append('Cloudflare')
                elif 'kona' in str(response.content).lower() or 'akamai' in str(response.content).lower():
                    detected.append('Kona SiteDefender')
                elif 'incapsula' in str(response.content).lower():
                    detected.append('Incapsula')
                elif 'sucuri' in str(response.content).lower():
                    detected.append('Sucuri')
                else:
                    detected.append('Generic WAF (block page)')
            
            if detected:
                self.waf_detected = ' + '.join(set(detected))
                self.waf_confidence = "MEDIUM (header-based detection)"
                self.generic_detection = "Header fingerprint match"
                self.waf_details = [
                    f"Fingerprint match: {self.waf_detected}",
                    f"Normal request: {normal_status}",
                    f"Security-pattern request: {security_status}",
                    "Independent header-based confirmation"
                ]
                self.request_count = "N/A"
            else:
                self.waf_detected = "No WAF Detected"
                self.waf_confidence = "LOW"
                self.waf_details = ["No WAF signatures found in headers"]
                self.generic_detection = "No WAF detected"
                self.request_count = "N/A"
                
            print("[+]  Basic WAF Detection complete")
            
        except Exception as e:
            self.waf_detected = "Detection Failed"
            self.waf_confidence = "N/A"
            self.waf_details = [f"Error: {str(e)}"]
            self.failed_sources.add('Basic WAF Detection')
    
