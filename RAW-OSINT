    def _extract_subdomains(self, text: str):
        sub_pattern = rf'([a-zA-Z0-9-]+)\.{re.escape(self.domain)}'
        found = re.findall(sub_pattern, text)
        for sub in found[:self.limit]:
            if sub not in ['www', 'mail', 'ftp']:
                self.subdomains.add(f"{sub}.{self.domain}")
    
    def _extract_urls(self, text: str):
        url_pattern = r'https?://[^\s<>"\'()]+'
        found = re.findall(url_pattern, text)
        for url in found[:self.limit]:
            if self.domain in url:
                self.urls.add(url)
    
