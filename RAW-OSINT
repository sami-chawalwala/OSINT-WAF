def main():
    parser = argparse.ArgumentParser(
        description="sam - OSINT Harvester",
        epilog="USE IT, ABUSE IT, WHO CARES "
    )
    
    mode_group = parser.add_mutually_exclusive_group(required=True)
    mode_group.add_argument('-d', '--domain', help='Target domain for OSINT scan')
    mode_group.add_argument('-waf', '--waf', help='Target URL for WAF detection (e.g., https://example.com)')
    
    parser.add_argument('-l', '--limit', type=int, default=500, help='Result limit per source')
    parser.add_argument('-t', '--timeout', type=int, default=15, help='Request timeout in seconds')
    parser.add_argument('--wordlist', help='Path to custom subdomain wordlist (one per line)')
    
    args = parser.parse_args()
    
    if args.waf:
        harvester = SamHarvester(url=args.waf, limit=args.limit, timeout=args.timeout)
    else:
        harvester = SamHarvester(domain=args.domain, limit=args.limit, timeout=args.timeout)
    
    if args.wordlist and not args.waf:
        try:
            with open(args.wordlist, 'r') as f:
                wordlist = [line.strip() for line in f if line.strip()]
            harvester.dns_bruteforce = lambda: None
        except:
            print(f"[-] Could not read wordlist: {args.wordlist}")
    
    harvester.run()

if __name__ == '__main__':
    main()
             
