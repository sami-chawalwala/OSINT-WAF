                        if name.startswith('*.'):
                            name = name[2:]
                        cleaned = name.strip()
                        if cleaned.endswith(f".{self.domain}") and cleaned != self.domain:
                            self.subdomains.add(cleaned)
        except:
            self.failed_sources.add('CRT.sh expanded')
    
    def discover_hosts(self):
        print(f"[+]   Discovering hosts for {self.domain}...")
        subdomains_list = list(self.subdomains)
        if not subdomains_list:
            print("[+]   No subdomains to resolve")
            return
        self.total_subdomains_discovered = len(subdomains_list)
        
        def resolve(host: str) -> Tuple[Set[str], Set[str]]:
            ipv4_set = set()
            ipv6_set = set()
            try:
                addrinfo = socket.getaddrinfo(host, None, socket.AF_INET)
                for addr in addrinfo:
                    ip = addr[4][0]
                    ipv4_set.add(ip)
                    self.ipv4_addresses.add(ip)
                    self.current_dns_ips.add(ip)
            except:
                pass
            try:
                addrinfo = socket.getaddrinfo(host, None, socket.AF_INET6)
                for addr in addrinfo:
                    ip = addr[4][0]
                    ipv6_set.add(ip)
                    self.ipv6_addresses.add(ip)
                    self.current_dns_ips.add(ip)
            except:
                pass
            if ipv4_set or ipv6_set:
                self.resolving_subdomains.add(host)
            else:
                self.non_resolving_subdomains.add(host)
            return (ipv4_set, ipv6_set)
        
        with ThreadPoolExecutor(max_workers=100) as executor:
            results = list(executor.map(resolve, subdomains_list))
        for i, (ipv4_set, ipv6_set) in enumerate(results):
            host = subdomains_list[i]
            for ip in ipv4_set:
                self.hosts.add(f"{host} -> {ip}")
            for ip in ipv6_set:
                self.hosts.add(f"{host} -> {ip}")
        self.dns_resolving_count = len(self.resolving_subdomains)
        self.dns_non_resolving_count = len(self.non_resolving_subdomains)
        self._add_historical_ips()
    
    def _add_historical_ips(self):
        try:
            whois_result = subprocess.run(['whois', self.domain], capture_output=True, text=True)
            if whois_result.stdout:
                ip_pattern = r'\b(?:\d{1,3}\.){3}\d{1,3}\b'
                found_ips = re.findall(ip_pattern, whois_result.stdout)
                for ip in found_ips[:10]:
                    if ip not in self.current_dns_ips:
                        self.historical_ips.add(ip)
                        self.ipv4_addresses.add(ip)
        except:
            pass
    
